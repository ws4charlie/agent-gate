# Every env var agentgate reads. Names only: copy to .env (gitignored), fill in
# what you use, never commit values. Most are optional; a flag of the same
# purpose wins over the env var. cmd/agentgate/envlist_test.go fails when this
# list and the code drift apart.

# --- shared (every command that opens the database) ---
# Postgres URL
DATABASE_URL=
# traces: stdout | otlp (OTEL_EXPORTER_OTLP_*); empty: off
AG_OTEL_EXPORTER=

# --- gateway: agentgate serve ---
# JSON config file (--config)
AG_CONFIG=
# address, default 127.0.0.1:8080
AG_LISTEN=
# providers and routes file, default configs/providers.json
AG_PROVIDERS=
# price table file, default configs/prices.json
AG_PRICES=
# payments config JSON; empty: POST /v1/payments is off (also console, reconcile)
AG_PAYMENTS=
# MCP upstream servers JSON; empty: /mcp/{server} is off
AG_MCP=
# true: deny models and tools not approved in the AI Registry
AG_REGISTRY_ENFORCE=
# directory of Cedar policies (shadow mode unless AG_CEDAR_ENFORCE)
AG_CEDAR_POLICIES=
# true: Cedar decides
AG_CEDAR_ENFORCE=
# accepted trust domains, comma separated (with --spiffe-listen)
AG_SPIFFE_TRUST_DOMAIN=
# the gateway's own SPIFFE ID when the Workload API returns several
AG_SPIFFE_ID=
# SPIFFE Workload API socket (gateway and console)
AG_SPIFFE_SOCKET=
# Gate credential Ed25519 seed file, default data/gate-cred.key
AG_GATE_CRED_KEY_FILE=
# key id of that seed
AG_GATE_CRED_KID=
# who approves or denies (agentgate approve/deny), default the OS user
AG_APPROVER=
# log format on stderr: text | json, default text (--log-format)
AG_LOG_FORMAT=

# --- model providers (one per provider in the providers file: <NAME>_API_KEY) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# MCP upstream credentials are named by each server's auth_env in the AG_MCP file.

# --- x402 payments: network sim signs with a throw-away key; anvil and base-sepolia sign only through QuorumVault ---
# chain JSON-RPC URL (anvil, base-sepolia; console balance)
AG_RPC_URL=

# --- x402 payments: QuorumVault signer (network anvil or base-sepolia; all required except AG_VAULT_TOKEN_CA, AG_VAULT_CRED_TTL) ---
# QuorumVault base URL
AG_VAULT_URL=
# wallet id in QuorumVault
AG_VAULT_WALLET_ID=
# that wallet's address, checked against QuorumVault
AG_VAULT_WALLET_ADDRESS=
# mTLS client certificate file
AG_VAULT_CERT=
# mTLS client key file
AG_VAULT_KEY=
# QuorumVault CA bundle file
AG_VAULT_CA=
# identity provider token URL
AG_VAULT_TOKEN_URL=
# OAuth client id
AG_VAULT_CLIENT_ID=
# file holding the OAuth client secret
AG_VAULT_CLIENT_SECRET_FILE=
# identity provider CA bundle; empty: system roots
AG_VAULT_TOKEN_CA=
# audience of the Gate credential
AG_VAULT_AUDIENCE=
# Gate credential lifetime (Go duration), default and most 90s
AG_VAULT_CRED_TTL=

# --- bank rail: agentgate serve --mercury (sandbox) ---
# true: turn the rail on
AG_MERCURY=
# Mercury API token (env only)
AG_MERCURY_TOKEN=
# checking account id payments are paid from
AG_MERCURY_ACCOUNT=
# API base URL, default the sandbox
AG_MERCURY_BASE_URL=
# status poll interval, default 30s
AG_MERCURY_POLL=
# egress proxy URL; empty: direct
AG_MERCURY_PROXY=

# --- paid tool: agentgate paidtool ---
# base-sepolia: key that pays gas to settle
AG_FACILITATOR_KEY=
# anvil: accept this deployed EIP-3009 token (0x...) instead of deploying a mock (--token)
AG_PAIDTOOL_TOKEN=
# real scraper upstream; empty: offline only
FIRECRAWL_API_KEY=

# --- console: agentgate console ---
# address, default 127.0.0.1:18095 (loopback only)
AG_CONSOLE_LISTEN=
# tasks and run results, default ~/.config/agentgate/console
AG_CONSOLE_DATA=
# gateway the tasks call, default http://127.0.0.1:8080
AG_GATEWAY_URL=
# show this wallet's USDC balance
AG_WALLET_ADDRESS=
# also serve HTTPS on this Tailscale address
AG_CONSOLE_TAILNET_LISTEN=
# this machine's tailnet name
AG_CONSOLE_TAILNET_HOST=
# certificate from `tailscale cert`
AG_CONSOLE_TAILNET_CERT=
# key from `tailscale cert`
AG_CONSOLE_TAILNET_KEY=
# logins allowed over the tailnet, comma separated
AG_CONSOLE_ALLOW=
# tailscaled LocalAPI socket
AG_TAILSCALE_SOCKET=

# --- runner: how the console starts runs ---
# agent=path pairs, comma separated; empty: tasks cannot run
AG_CONSOLE_RUNNERS=
# SPIFFE ID runs present; empty: runs use the agent's API key
AG_RUNNER_SPIFFE_ID=
# gateway mTLS address runs call with that certificate
AG_RUNNER_GATEWAY_URL=
# unix user runs start as (systemd agentgate-run@<id>)
AG_RUNNER_USER=
# runners that run as that user, comma separated
AG_RUNNER_USER_RUNNERS=
# group a run's directory is shared with
AG_RUNNER_GROUP=
# spire-agent program, default /opt/spire/bin/spire-agent
AG_SPIRE_AGENT_BIN=

# --- scripts/agentgate-local only (all optional) ---
# prebuilt binary; empty: build it
AG_BIN=
# logs and state, default ~/.local/state/agentgate
AG_LOCAL_STATE=
# set to start the paid tool: sim | anvil | base-sepolia
AG_PAIDTOOL_NETWORK=
# paid tool address, default 127.0.0.1:9402
AG_PAIDTOOL_LISTEN=
# paid tool payee address
AG_PAIDTOOL_PAY_TO=
# scraper cache directory
AG_PAIDTOOL_CACHE=
