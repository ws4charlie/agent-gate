 {
  "id": "allow-new-task-new-window",
  "category": "allow",
  "description": "The task budget is keyed by a header the caller chooses: after task t1 is exhausted, a new task value gets a fresh window. It limits a cooperative client, not a hostile one.",
  "setup": {
   "models": [
    "fake/chat"
   ],
   "task": 0.3
  },
  "steps": [
   {
    "op": "chat",
    "model": "fake/chat",
    "task": "t1",
    "repeat": 6
   },
   {
    "op": "chat",
    "model": "fake/chat",
    "task": "t2"
   }
  ],
  "expected": "allow",
  "rule": "allow"
 },
